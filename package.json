{
  "name": "outsiderdrop",
  "version": "1.0.0",
  "description": "Kirim file (sampai ukuran GB) dan pesan langsung antarperangkat: Android, iPhone, Windows, Mac, Linux. File mengalir langsung perangkat ke perangkat (WebRTC), tidak disimpan di server.",
  "main": "server-lokal.js",
  "scripts": {
    "start": "node server-lokal.js",
    "build": "pkg . --compress GZip --out-path dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.25.0"
  },
  "bin": "server-lokal.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-win-x64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-linux-x64",
      "node22-linux-arm64"
    ]
  }
}